{
  "name": "stagewallstudio",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Keep the variables set in the Cloudflare dashboard (CONTACT_TO, CONTACT_FROM) when this deploys
  "keep_vars": true,
  // Branch builds (pull requests) run `wrangler preview`, which needs this block; it can stay empty
  "previews": {}
}
