{
  "name": "stagewallstudio",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Keep the variables set in the Cloudflare dashboard (CONTACT_TO, CONTACT_FROM) when this deploys
  "keep_vars": true,
  // Branch builds (pull requests) run `wrangler preview`, which needs this block; it can stay empty
  "previews": {},
  // Showcaller Intercom: one room per director's computer, so crew can join from anywhere (intercom.js)
  // Showcaller Hub: which apps each computer has installed, read by the Admin app (installs.js)
  // Showcaller Link: one relay per studio, so clients get in without a port opened at the studio (link-relay.js)
  // Showcaller Sessions: one room per recording session, guests join at /s/<room> (sessions.js); accounts live in the same class (sessions-accounts.js)
  "durable_objects": { "bindings": [{ "name": "INTERCOM", "class_name": "IntercomRoom" }, { "name": "HUB_INSTALLS", "class_name": "HubInstalls" }, { "name": "LINK_RELAY", "class_name": "LinkRelay" }, { "name": "SESSIONS_ROOM", "class_name": "SessionRoom" }] },
  "migrations": [{ "tag": "intercom-v1", "new_sqlite_classes": ["IntercomRoom"] }, { "tag": "hub-installs-v1", "new_sqlite_classes": ["HubInstalls"] }, { "tag": "link-relay-v1", "new_sqlite_classes": ["LinkRelay"] }, { "tag": "sessions-v1", "new_sqlite_classes": ["SessionRoom"] }],
  // Showcaller Sessions: each guest's recording, uploaded in pieces until the studio Mac downloads it (sessions.js).
  // Create the bucket first (Cloudflare dashboard → R2 → Create bucket "showcaller-sessions"), or deploys fail.
  "r2_buckets": [{ "binding": "SESSIONS", "bucket_name": "showcaller-sessions" }]
}
